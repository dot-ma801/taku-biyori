{
  "name": "@taku-biyori/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint . --fix --cache",
    "lint:oxlint": "oxlint . --fix",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxlint",
    "lint:check": "eslint . && oxlint .",
    "format": "prettier --write . --config prettier.config.mjs --ignore-path .prettierignore",
    "format:check": "prettier --check . --config prettier.config.mjs --ignore-path .prettierignore",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.0.18"
  }
}
