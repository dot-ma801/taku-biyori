{
  "mcpServers": {
    "postgres-db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-postgres",
        "postgresql://app:pass@localhost:5432/taku-biyori"
      ],
      "env": {}
    },
    "vuetify-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@vuetify/mcp"
      ]
    }
  }
}
