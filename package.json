{
  "name": "taku-biyori",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "test": "pnpm -r run test",
    "test:coverage": "pnpm -r run test:coverage",
    "check": "node scripts/check.mjs",
    "check:ci": "node scripts/check.mjs --ci",
    "rules:sync": "rulesync generate --delete",
    "rules:check": "rulesync generate --check --features rules,subagents,skills,hooks,permissions"
  },
  "packageManager": "pnpm@10.30.3",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@taku-biyori/backend": "workspace:*",
    "@taku-biyori/frontend": "workspace:*",
    "rulesync": "^16.18.0"
  }
}
