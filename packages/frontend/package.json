{
  "name": "@taku-biyori/frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "vrt": "pnpm run build-storybook --quiet && playwright test -c playwright.vrt.config.ts",
    "vrt:update": "pnpm run build-storybook --quiet && playwright test -c playwright.vrt.config.ts --update-snapshots",
    "check:raw-color": "node scripts/check-raw-color.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "oxlint . && eslint .",
    "format": "prettier --write . --config ../shared/prettier.config.mjs --ignore-path ../shared/.prettierignore",
    "format:check": "prettier --check . --config ../shared/prettier.config.mjs --ignore-path ../shared/.prettierignore",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/quicksand": "5.3.0",
    "@lucide/vue": "^1.16.0",
    "@taku-biyori/shared": "workspace:*",
    "@vuetify/v0": "1.0.0-alpha.5",
    "better-auth": "^1.6.11",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-boring-avatars": "^1.4.0",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@storybook/vue3-vite": "^10.4.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-playwright": "^2.8.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "storybook": "^10.4.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
