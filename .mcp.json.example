{
  "mcpServers": {
    "postgres-db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-postgres",
        "postgresql://app:password@localhost:5432/app_template"
      ],
      "env": {}
    },
    "vuetify-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@vuetify/mcp"
      ]
    }
  }
}
