# Database
DATABASE_URL=postgresql://app:password@localhost:5432/app_template

# Test Database
# リポジトリ層のテストが接続する実 DB。開発用 DB とは別のデータベースを指すこと
# （テストは各ケースをトランザクションでロールバックするが、接続先を分けておく方が安全）。
# ローカルと CI で接続先を切り替える唯一の変数。
# 初期化は `pnpm --filter @taku-biyori/backend db:test:setup`（無ければ作成し、マイグレーションを適用する）
TEST_DATABASE_URL=postgresql://app:password@localhost:5432/taku_biyori_test

# Server
PORT=3000

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# OAuth Providers (optional - uncomment and fill in your credentials)
# GitHub OAuth
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Discord OAuth
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret
